# Copy to .env and fill in. Never commit .env.

# Google Gemini API key for the LangGraph agent (active provider)
GEMINI_API_KEY=your-key-here

# Optional: Anthropic key, only if you switch agent.provider back to "anthropic"
# ANTHROPIC_API_KEY=

# Database (SQLite for dev)
DATABASE_URL=sqlite:///routeguard.sqlite

# Which model version the serving layer should load
MODEL_VERSION=model_v1

# Environment: dev | prod
ENV=dev
